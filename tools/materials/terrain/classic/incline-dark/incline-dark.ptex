  "nodes": [
    {
      "name": "About",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": -450
      },
      "size": {
        "x": 900,
        "y": 190
      },
      "title": "About this material",
      "text": "Numeric artwork, not colour (128 px): the game reads the RGB as detail values and the alpha as coverage, so they are exported without colour conversion. ArtworkControls: the detail contrast and bias edit the detail, Coverage opacity the alpha. The ...PNG8 groups and the nodes after them only store exact file values; leave them. Export: File > Export material > Godot > Godot 4 Standard into data/models/board/textures/terrain/classic, then Reload assets in the game's Tuning panel.",
      "color": {
        "type": "Color",
        "r": 0.22,
        "g": 0.25,
        "b": 0.3,
        "a": 1
      }
    },
    {
