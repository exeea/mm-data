    {
      "name": "About",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": -300
      },
      "size": {
        "x": 900,
        "y": 166
      },
      "title": "About this material",
      "text": "Colour artwork from sources/artwork.png and its normal map from sources/normal.png, 1024 px: the road tunnels' concrete (their GLBs name this material), the precast retaining walls and the dragon's teeth. Pigment adjusts hue, saturation and value; the defaults keep the artwork as it is. The ...PNG8 groups and the nodes after them only store exact file values; leave them. Export: File > Export material > Godot > Godot 4 Standard into data/models/board/textures/scenery, then Reload assets in the game's Tuning panel.",
      "color": {
        "type": "Color",
        "r": 0.2,
        "g": 0.25,
        "b": 0.3,
        "a": 1
      }
    },
