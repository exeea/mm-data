    {
      "name": "About",
      "type": "comment",
      "parameters": {},
      "node_position": {
        "x": 0,
        "y": -400
      },
      "size": {
        "x": 900,
        "y": 190
      },
      "title": "About this material",
      "text": "Plant texture from sources/shrub-highland.png with its height fields (structure-high/low), 1024 px. Pigment edits the colour; SurfaceResponse the normals, AO, roughness and light transmission. Keep the layout: the models point at its parts. The ...PNG8 groups and the nodes after them only store exact file values; leave them. Export: File > Export material > Godot > Godot 4 Standard into data/models/board/textures/vegetation/shrubs, then Reload assets in the game's Tuning panel.",
      "color": {
        "type": "Color",
        "r": 0.18,
        "g": 0.26,
        "b": 0.18,
        "a": 1
      }
    },
