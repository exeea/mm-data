      },
      "title": "About this material",
      "text": "The wheat row's top view: seven plants on a 1024 px canvas. Their stem and crown anchors are in data/models/board/textures/vegetation/wheat-row.json; keep the plants where those expect them. The ...PNG8 groups and the nodes after them only store exact file values; leave them. Export: File > Export material > Godot > Godot 4 Standard into data/models/board/textures/vegetation, then Reload assets in the game's Tuning panel.",
      "color": {
        "type": "Color",
        "r": 0.18,
        "g": 0.26,
        "b": 0.18,
        "a": 1
      }
    },
